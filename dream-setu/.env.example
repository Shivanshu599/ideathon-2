# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or any real key.

# Any provider with an OpenAI-compatible /chat/completions endpoint works.
# Check your provider's docs for the exact base URL and current model names.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional: set to true only if your provider supports response_format json_object
LLM_JSON_MODE=false

# Optional LIVE job data (free key at developer.adzuna.com). Makes roadmaps use real job ads.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
